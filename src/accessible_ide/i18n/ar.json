  "try.hex_help": "\u064a\u0628\u062f\u0623 \u0628\u0639\u0644\u0627\u0645\u0629 #\u060c \u062b\u0645 3 \u0623\u0648 6 \u0623\u062d\u0631\u0641 \u0623\u0648 \u0623\u0631\u0642\u0627\u0645\u060c \u0645\u062b\u0644 #ffd93d. \u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0644\u0648\u0646 \u0627\u0644\u0633\u0645\u0629.",
  "try.hex_label": "\u0631\u0645\u0632 \u0627\u0644\u0644\u0648\u0646",
  "try.hint": "\u0634\u0627\u0647\u062f \u0634\u0643\u0644 \u062e\u0637\u0643 \u0648\u0644\u0648\u0646\u0643 \u0642\u0628\u0644 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0647\u0645\u0627. \u0643\u0644 \u0645\u0627 \u062a\u062a\u063a\u064a\u0631\u0647 \u0647\u0646\u0627 \u064a\u064f\u062d\u0641\u0638 \u0641\u0648\u0631\u064b\u0627.",
  "try.nudge_help": "\u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0644\u0648\u0646 \u0633\u064a\u0635\u0639\u0628 \u0642\u0631\u0627\u0621\u062a\u0647 \u0639\u0644\u0649 \u0633\u0645\u062a\u0643\u060c \u064a\u0639\u062f\u0651\u0644\u0647 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062d\u062a\u0649 \u064a\u0635\u0628\u062d \u0633\u0647\u0644 \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",
  "try.picker_label": "\u0627\u062e\u062a\u0631 \u0644\u0648\u0646\u064b\u0627 \u0645\u0646 \u0623\u062f\u0627\u0629 \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0623\u0644\u0648\u0627\u0646",
  "try.preview": "\u0645\u0639\u0627\u064a\u0646\u0629",
  "try.reset": "\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0644\u0648\u0646 \u0627\u0644\u0633\u0645\u0629",
  "try.sample_default": "\u0646\u0635 \u062d\u0643\u064a\u0645 \u0644\u0647 \u0633\u0631 \u0642\u0627\u0637\u0639 \u0648\u0630\u0648 \u0634\u0623\u0646 \u0639\u0638\u064a\u0645 \u0645\u0643\u062a\u0648\u0628 \u0639\u0644\u0649 \u062b\u0648\u0628 \u0623\u062e\u0636\u0631 \u0648\u0645\u063a\u0644\u0641 \u0628\u062c\u0644\u062f \u0623\u0632\u0631\u0642.",
  "try.sample_help": "\u0627\u0643\u062a\u0628 \u0623\u064a \u0643\u0644\u0645\u0627\u062a \u062a\u0631\u064a\u062f\u0647\u0627. \u0627\u0644\u0645\u0639\u0627\u064a\u0646\u0629 \u0628\u0627\u0644\u0623\u0633\u0641\u0644 \u062a\u062a\u063a\u064a\u0631 \u0645\u0639\u0647\u0627.",
  "try.sample_text": "\u0643\u0644\u0645\u0627\u062a \u0644\u0644\u062a\u062c\u0631\u0628\u0629",
  "try.status_custom": "\u0639\u0631\u0636 {0} \u0628\u0644\u0648\u0646 {1}.",
  "try.status_nudged": "\u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0633\u0645\u0629 \u062a\u0645 \u062a\u0641\u062a\u064a\u062d\u0647 \u0623\u0648 \u062a\u0639\u062a\u064a\u0645\u0647 \u062d\u062a\u0649 {0} \u0644\u064a\u0628\u0642\u0649 \u0633\u0647\u0644 \u0627\u0644\u0642\u0631\u0627\u0621\u0629.",
  "try.status_theme": "\u0639\u0631\u0636 {0} \u0628\u0644\u0648\u0646 \u0627\u0644\u0633\u0645\u0629.",
  "try.swatch_help": "\u0627\u062e\u062a\u0631 \u0645\u0631\u0628\u0639\u064b\u0627\u060c \u0623\u0648 \u0627\u0643\u062a\u0628 \u0631\u0645\u0632 \u0623\u064a \u0644\u0648\u0646 \u0628\u0627\u0644\u0623\u0633\u0641\u0644.",
  "try.system_font": "{0} \u064a\u0623\u062a\u064a \u0645\u0646 \u062d\u0627\u0633\u0648\u0628\u0643. \u0625\u0630\u0627 \u0644\u0645 \u064a\u0638\u0647\u0631\u060c \u0633\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u062e\u0637 \u0645\u0631\u0641\u0642 \u0628\u062f\u0644\u0627\u064b \u0645\u0646\u0647.",
